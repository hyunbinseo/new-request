{
	"name": "new-request",
	"version": "0.0.40",
	"description": "Type-check and autocomplete for 3rd party REST API requests",
	"homepage": "https://github.com/hyunbinseo/new-request#readme",
	"bugs": {
		"url": "https://github.com/hyunbinseo/new-request/issues"
	},
	"license": "MIT",
	"author": "Hyunbin Seo",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hyunbinseo/new-request.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#lib/*": "./src/lib/*",
		"#bizgo/channels/*": "./src/message/bizgo/v1/channels/*",
		"#bizgo/testing/*": "./src/message/bizgo/v1/testing/*",
		"#bizgo/reservation": "./src/message/bizgo/v1/reservation/types.ts",
		"#bizgo/response": "./src/message/bizgo/v1/response.ts"
	},
	"exports": {
		"./email/postmark/POST": "./dist/email/postmark/POST/index.js",
		"./email/send-grid/v3/POST": "./dist/email/send-grid/v3/POST/index.js",
		"./message/bizgo/v1/reservation/list/GET": "./dist/message/bizgo/v1/reservation/list/GET/index.js",
		"./message/bizgo/v1/reservation/POST": "./dist/message/bizgo/v1/reservation/POST/index.js",
		"./message/bizgo/v1/reservation/resvKey/cancel/POST": "./dist/message/bizgo/v1/reservation/resvKey/cancel/POST/index.js",
		"./message/bizgo/v1/reservation/resvKey/destinations/GET": "./dist/message/bizgo/v1/reservation/resvKey/destinations/GET/index.js",
		"./message/bizgo/v1/reservation/resvKey/destinations/msgKey/DELETE": "./dist/message/bizgo/v1/reservation/resvKey/destinations/msgKey/DELETE/index.js",
		"./message/bizgo/v1/reservation/resvKey/destinations/POST": "./dist/message/bizgo/v1/reservation/resvKey/destinations/POST/index.js",
		"./message/bizgo/v1/reservation/resvKey/GET": "./dist/message/bizgo/v1/reservation/resvKey/GET/index.js",
		"./message/bizgo/v1/reservation/resvKey/PUT": "./dist/message/bizgo/v1/reservation/resvKey/PUT/index.js",
		"./message/bizgo/v1/reservation/resvKey/resume/POST": "./dist/message/bizgo/v1/reservation/resvKey/resume/POST/index.js",
		"./message/bizgo/v1/reservation/resvKey/stop/POST": "./dist/message/bizgo/v1/reservation/resvKey/stop/POST/index.js",
		"./message/bizgo/v1/send/omni/POST": "./dist/message/bizgo/v1/send/omni/POST/index.js",
		"./message/dooray/POST": "./dist/message/dooray/POST/index.js",
		"./message/pushover/1/POST": "./dist/message/pushover/1/POST/index.js",
		"./sms/nhn/v3.0/POST": "./dist/sms/nhn/v3.0/POST/index.js",
		"./sms/twilio/2010-04-01/POST": "./dist/sms/twilio/2010-04-01/POST/index.js",
		"./tts/naver/v1/POST": "./dist/tts/naver/v1/POST/index.js",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepack": "tsdown",
		"test": "node --test --env-file-if-exists=.env",
		"version": "tsdown && git add package.json",
		"postversion": "git push && git push --tags && node cli/postversion.ts",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@types/node": "^20.19.43",
		"oxfmt": "^0.70.0",
		"oxlint": "^1.85.0",
		"oxlint-tsgolint": "^7.0.2002",
		"publint": "^0.3.24",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2",
		"valibot": "^1.5.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.5.1",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "24.21.0",
			"onFail": "download"
		}
	},
	"engines": {
		"node": ">=20"
	}
}
