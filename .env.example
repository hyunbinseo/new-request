# Real Bizgo API key (starts with mars_). Tests fall back to a mock key when unset.
BIZGO_API_KEY=

# Real phone number to use as the SMS/알림톡 sender and recipient in live tests.
BIZGO_PHONE_NUMBER=

# Real Kakao 알림톡 발신프로필 senderKey, registered with Bizgo.
BIZGO_KAKAO_SENDER_KEY=

# Real approved 알림톡 템플릿 코드.
BIZGO_KAKAO_TEMPLATE_CODE=
