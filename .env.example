# Sandbox credentials for integration tests.
# A test runs only when all of its variables are set.

# See https://postmarkapp.com/developer/api/overview#testing-api
POSTMARK_SERVER_TOKEN="POSTMARK_API_TEST"

# See https://www.twilio.com/docs/iam/test-credentials
TWILIO_TEST_ACCOUNT_SID=""
TWILIO_TEST_AUTH_TOKEN=""

# See https://developers.zoom.us/docs/internal-apps/s2s-oauth/
# Zoom has no sandbox. Uses a Server-to-Server OAuth app on a real account.
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
