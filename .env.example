# Real Bizgo credentials for the live tests. Leave any unset to skip the tests that need it.

# Real Bizgo API key (starts with mars_).
BIZGO_API_KEY=

# Real sender/recipient phone number (digits only, e.g. 01012345678).
BIZGO_PHONE_NUMBER=

# Real Kakao 알림톡 발신프로필 senderKey (registered with Bizgo).
BIZGO_KAKAO_SENDER_KEY=

# Real Kakao 알림톡 템플릿 코드 (approved).
BIZGO_KAKAO_TEMPLATE_CODE=
